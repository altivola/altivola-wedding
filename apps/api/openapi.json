                              }
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "type",
                            "palette",
                            "cover",
                            "sections",
                            "note"
                          ]
                        },
                        "photos": {
                          "type": "array",
                          "maxItems": 9,
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
