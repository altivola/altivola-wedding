// Cloudflare Workers config (free phase). One Worker serves the web app (static assets)
// and the API, so both share one origin on workers.dev without a custom domain.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wedding",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  // Altivola Auth is a separate Worker on the same workers.dev zone.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // The built web app. Only /api and /rpc reach the Worker code; every other path is a
  // file from here, and unknown paths get index.html so client side routing works.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/rpc/*"]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Dedicated Wedding database. Keep Hyperdrive caching disabled.
      "id": "99f8ed2730224d82b104cee9cf858c46",
      // Used by `wrangler dev`. Matches compose.yaml with the default DB_PORT.
      "localConnectionString": "postgres://app:app@localhost:5432/app"
    }
  ],

  "d1_databases": [
    {
      "binding": "WEDDING_MEDIA",
      "database_name": "altivola-wedding-media",
      "database_id": "2252feb9-b5d0-4633-833f-14e8f7c2b8b9",
      "migrations_dir": "d1/migrations"
    }
  ],

  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "altivola-wedding-jobs" }],
    "consumers": [{ "queue": "altivola-wedding-jobs", "max_retries": 3 }]
  },

  // Non secret settings. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, OAuth keys) go in
  // `wrangler secret put <NAME>`, and in .dev.vars for `wrangler dev`.
  "vars": {
    "BETTER_AUTH_URL": "https://wedding.altivola.workers.dev",
    // "none" until Resend is set up; sign in is Google/GitHub only meanwhile.
    "MAIL_PROVIDER": "none",
    "MAIL_FROM": "App <noreply@example.com>"
  }
}
