    "/weddings/{weddingId}/guests/{guestId}/rsvp": {
      "post": {
        "operationId": "weddings.rsvp",
        "summary": "Save a guest RSVP",
        "parameters": [
          {
            "name": "weddingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "guestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attending": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "attending"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attending": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "attending"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
